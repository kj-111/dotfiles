# Wat hier ontbreekt, staat al goed als default. Waarom de rest zo staat:
# nvim/docs/terminal-weergave.md.

# ─── Venster ─────────────────────────────────────────────────────────────────

window-decoration = none
macos-window-shadow = false
macos-option-as-alt = true
quit-after-last-window-closed = true
window-padding-x = 0
window-padding-y = 0
confirm-close-surface = false
resize-overlay = never
progress-style = false
auto-update = off

# ─── Font: Monaspace Neon ────────────────────────────────────────────────────

font-family = MonaspiceNe Nerd Font Mono
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 15.5
font-feature = -liga, +calt
font-thicken = true
adjust-cell-width = 1

# ─── Kleuren: Nord ───────────────────────────────────────────────────────────

background = #2e3440
foreground = #d8dee9

selection-background = #4c566a
selection-foreground = #eceff4

palette = 0=#3b4252
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#81a1c1
palette = 5=#b48ead
palette = 6=#88c0d0
palette = 7=#e5e9f0

palette = 8=#4c566a
palette = 9=#bf616a
palette = 10=#a3be8c
palette = 11=#ebcb8b
palette = 12=#81a1c1
palette = 13=#b48ead
palette = 14=#8fbcbb
palette = 15=#eceff4

# ─── Cursor ──────────────────────────────────────────────────────────────────

cursor-color = #88c0d0
cursor-text = #2e3440
cursor-style-blink = false
adjust-cursor-thickness = 4
custom-shader = shaders/cursor_warp.glsl
custom-shader-animation = true

# ─── Muis en klembord ────────────────────────────────────────────────────────

mouse-hide-while-typing = true
mouse-scroll-multiplier = precision:3
copy-on-select = false

# ─── Shell, bel en meldingen ─────────────────────────────────────────────────

shell-integration-features = no-cursor,sudo
bell-features = no-attention
notify-on-command-finish = unfocused
notify-on-command-finish-after = 15s
notify-on-command-finish-action = no-bell,notify

# ─── Sneltoetsen ─────────────────────────────────────────────────────────────

keybind = clear
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+n=new_window
keybind = super+k=increase_font_size:0.5
keybind = super+j=decrease_font_size:0.5
keybind = super+0=reset_font_size
