# Zo kaal mogelijk: wat hier ontbreekt, staat al goed als default. De weergave
# is afgemeten aan alacritty; die vergelijking staat in
# nvim/docs/terminal-weergave.md.

# ─── Venster ─────────────────────────────────────────────────────────────────
# none haalt ook de tabs weg: dat dwingt macOS af bij vensters zonder titelbalk.

window-decoration = none
macos-window-shadow = false
macos-option-as-alt = true
quit-after-last-window-closed = true
window-padding-x = 0
window-padding-y = 0
confirm-close-surface = false
auto-update = off

# aerospace verandert het venster bij elke layoutwissel; de overlay zou dan
# telkens opflitsen.
resize-overlay = never

# ─── Font: Monaspace Neon ────────────────────────────────────────────────────
# Stijlen expliciet: de Medium-face adverteert nameID 2 = "Regular", waardoor
# automatisch matchen op Bold kan misgrijpen (dat deed kitty).
# calt aan = texture healing, zoals in neovide; liga uit.
# adjust-cell-width brengt de cel van 19 naar 20 px, gelijk aan alacritty.
# font-thicken is ghostty's naam voor CoreGraphics' font smoothing; alacritty
# zet die altijd aan, ghostty niet.

font-family = MonaspiceNe Nerd Font Mono
font-style = Regular
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic
font-size = 15.5
font-feature = -liga, +calt
font-thicken = true
adjust-cell-width = 1

# ─── Kleuren: Nord ───────────────────────────────────────────────────────────
# Zelfde palet als nvim/colors/nord.lua.

background = #2e3440
foreground = #d8dee9

selection-background = #4c566a
selection-foreground = #eceff4

palette = 0=#3b4252
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#81a1c1
palette = 5=#b48ead
palette = 6=#88c0d0
palette = 7=#e5e9f0

palette = 8=#4c566a
palette = 9=#bf616a
palette = 10=#a3be8c
palette = 11=#ebcb8b
palette = 12=#81a1c1
palette = 13=#b48ead
palette = 14=#8fbcbb
palette = 15=#eceff4

# ─── Cursor en muis ──────────────────────────────────────────────────────────
# no-cursor houdt de shell-integratie van de cursorvorm af. sudo staat bij
# ghostty standaard uit, bij kitty aan; die zet terminfo door onder sudo.

cursor-color = #88c0d0
cursor-text = #2e3440
cursor-style-blink = false
adjust-cursor-thickness = 4
shell-integration-features = no-cursor,sudo

# Cursor trail: vier hoeken met een eigen duur, net als neovide. always omdat
# de cursor bij verlies van focus hol wordt en de animatie anders bevriest.
custom-shader = shaders/cursor_warp.glsl
custom-shader-animation = always

mouse-hide-while-typing = true
mouse-scroll-multiplier = precision:3

# copy-on-select staat op macOS standaard aan, in alacritty niet.
copy-on-select = false

# ─── Bel en meldingen ────────────────────────────────────────────────────────

bell-features = no-attention
notify-on-command-finish = unfocused
notify-on-command-finish-after = 15s
notify-on-command-finish-action = no-bell,notify

# ─── Sneltoetsen ─────────────────────────────────────────────────────────────

keybind = clear
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+n=new_window
keybind = super+k=increase_font_size:0.5
keybind = super+j=decrease_font_size:0.5
keybind = super+0=reset_font_size
