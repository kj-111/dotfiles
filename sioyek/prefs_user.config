# Sioyek 3 (ARM64 native build, sioyek3-alpha0)
#
# Sioyek database files:
# Original macOS database paths:
#   ~/Library/Application Support/sioyek/local.db
#   ~/Library/Application Support/sioyek/shared.db
# These paths are symlinks to repo-backed database files:
#   ~/academia/.sioyek/local.db
#   ~/academia/.sioyek/shared.db
# Other Sioyek files stay in the original macOS directory.

font_size 23
ui_font MonaspiceNe Nerd Font Mono

custom_background_color 0.863 0.863 0.800
custom_text_color 0.121 0.121 0.121

background_color 0.184 0.204 0.247
dark_mode_background_color 0.184 0.204 0.247
ui_background_color 0.306 0.337 0.408

super_fast_search 1
smooth_scroll 1
show_scrollbar 0

startup_commands toggle_titlebar;toggle_custom_color
